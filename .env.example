# ==============================================================================
# CostGate Environment Configuration (.env)
# ==============================================================================

# Google Gemini API Key (keep secret, never commit)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Placeholders (to be replaced with actual Gemini model IDs)
MODEL_SMALL=MODEL_SMALL
MODEL_MEDIUM=MODEL_MEDIUM
MODEL_LARGE=MODEL_LARGE
MODEL_EMBEDDING=text-embedding-004

# Model Pricing per 1,000,000 (1M) Tokens in USD
# Small Model Tier
PRICE_INPUT_SMALL=0.075
PRICE_OUTPUT_SMALL=0.30

# Medium Model Tier
PRICE_INPUT_MEDIUM=0.15
PRICE_OUTPUT_MEDIUM=0.60

# Large Model Tier
PRICE_INPUT_LARGE=1.25
PRICE_OUTPUT_LARGE=5.00

# Gateway Routing Thresholds
CACHE_SIMILARITY_THRESHOLD=0.85
QUALITY_THRESHOLD=0.70

# LLM Client Resiliency (Timeouts & Exponential Backoff)
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Database Configuration
DB_PATH=costgate.db

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
