# ==============================================================================
# CostGate Environment Configuration Template (.env.example)
# ==============================================================================

# Google Gemini API Key (Required for live calls, never commit)
GEMINI_API_KEY=your_gemini_api_key_here

# Required Model Identifiers (Placeholders - must be configured before running)
MODEL_SMALL=MODEL_SMALL
MODEL_MEDIUM=MODEL_MEDIUM
MODEL_LARGE=MODEL_LARGE
EMBEDDING_MODEL=EMBEDDING_MODEL

# Gateway Routing Flags
ENABLE_MEDIUM=false

# Price Snapshot Date
PRICE_DATE=2026-10-02

# Required Model Pricing per 1,000,000 (1M) Tokens in USD (No silent defaults)
PRICE_INPUT_SMALL=0.30
PRICE_OUTPUT_SMALL=2.50

PRICE_INPUT_MEDIUM=0.75
PRICE_OUTPUT_MEDIUM=3.75

PRICE_INPUT_LARGE=0.75
PRICE_OUTPUT_LARGE=3.75

PRICE_EMBEDDING=0.20

# Routing Confidence Thresholds (route_low_conf must be < route_high_conf)
ROUTE_HIGH_CONF=0.75
ROUTE_LOW_CONF=0.40

# Semantic Cache Configuration
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=72

# Quality Gating (0.0 to 1.0 scale)
QUALITY_THRESHOLD=0.8

# LLM Client Resiliency
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Database Configuration
DB_PATH=costgate.db

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
