# ==============================================================================
# CostGate Environment Configuration (.env)
# ==============================================================================

# Google Gemini API Key (keep secret, never commit)
GEMINI_API_KEY=your_gemini_api_key_here

# Required Model Identifiers (Replace placeholders with actual model IDs before starting)
MODEL_SMALL=MODEL_SMALL
MODEL_MEDIUM=MODEL_MEDIUM
MODEL_LARGE=MODEL_LARGE
EMBEDDING_MODEL=text-embedding-004

# Required Model Pricing per 1,000,000 (1M) Tokens in USD (No silent defaults)
# Small Model Tier
PRICE_INPUT_SMALL=0.075
PRICE_OUTPUT_SMALL=0.30

# Medium Model Tier
PRICE_INPUT_MEDIUM=0.15
PRICE_OUTPUT_MEDIUM=0.60

# Large Model Tier
PRICE_INPUT_LARGE=1.25
PRICE_OUTPUT_LARGE=5.00

# Routing Confidence Thresholds (route_low_conf must be < route_high_conf)
ROUTE_HIGH_CONF=0.75
ROUTE_LOW_CONF=0.40

# Semantic Cache Configuration
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_TTL_HOURS=72

# Quality Gating (0.0 to 1.0 scale)
# Note: Any 1-5 confidence rating must be divided by 5 before comparing against quality_threshold.
QUALITY_THRESHOLD=0.8

# LLM Client Resiliency (Timeouts & Exponential Backoff)
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Database Configuration
DB_PATH=costgate.db

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
